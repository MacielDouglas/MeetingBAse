{
  "name": "Meeting Base",
  "slug": "meeting-base",
  "version": "0.1.0",
  "scheme": "meeting-base",
  "platforms": ["ios", "android"],
  "plugins": [
    "expo-router",
    "expo-sqlite",
    "expo-secure-store",
    "expo-sharing",
    [
      "expo-notifications",
      {
        "icon": "./assets/adaptive-icon.png",
        "color": "#ffffff"
      }
    ]
  ],
  "experiments": {
    "typedRoutes": false
  },
  "ios": {
    "bundleIdentifier": "com.meetingbase.app",
    "supportsTablet": true
  },
  "android": {
    "package": "com.meetingbase.app",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "edgeToEdgeEnabled": true
  },
  "extra": {
    "eas": {
      "projectId": ""
    }
  }
}

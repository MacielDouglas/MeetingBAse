{
  "name": "Meeting Base",
  "slug": "meeting-base",
  "version": "0.1.0",
  "scheme": "meeting-base",
  "platforms": ["ios", "android"],
  "plugins": [
    "expo-router",
    "expo-sqlite",
    "expo-secure-store",
    "expo-sharing",
    "expo-notifications"
  ],
  "experiments": {
    "typedRoutes": false
  },
  "ios": {
    "bundleIdentifier": "com.meetingbase.app",
    "supportsTablet": true
  },
  "android": {
    "package": "com.meetingbase.app",
    "edgeToEdgeEnabled": true
  },
  "extra": {
    "eas": {
      "projectId": ""
    }
  }
}
